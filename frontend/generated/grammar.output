Terminals unused in grammar

    ERROR_TOKEN


Grammar

    0 $accept: program $end

    1 program: function_list

    2 function_list: %empty
    3              | function_list function_decl

    4 function_decl: type IDENTIFIER '(' opt_param_list ')' block

    5 opt_param_list: %empty
    6               | param_list

    7 param_list: param
    8           | param_list ',' param

    9 param: type IDENTIFIER
   10      | type OP_BACKSLASH OP_BACKSLASH IDENTIFIER

   11 type: base_type
   12     | KW_PTR type
   13     | '[' INT_LITERAL ']' type

   14 base_type: KW_I32
   15          | KW_I64
   16          | KW_BOOL
   17          | KW_CHAR
   18          | KW_VOID

   19 block: '{' statement_list '}'

   20 statement_list: %empty
   21               | statement_list statement

   22 statement: var_decl ';'
   23          | if_stmt
   24          | while_stmt
   25          | return_stmt ';'
   26          | expr ';'
   27          | block
   28          | ';'

   29 var_decl: type IDENTIFIER
   30         | type IDENTIFIER '=' expr

   31 if_stmt: KW_IF '(' expr ')' block elif_list opt_else

   32 elif_list: %empty
   33          | elif_list KW_ELIF '(' expr ')' block

   34 opt_else: %empty
   35         | KW_ELSE block

   36 while_stmt: KW_WHILE '(' expr ')' block

   37 return_stmt: KW_RETURN
   38            | KW_RETURN expr

   39 expr: expr '=' expr
   40     | expr OP_ADD_ASSIGN expr
   41     | expr OP_SUB_ASSIGN expr
   42     | expr OP_MUL_ASSIGN expr
   43     | expr OP_DIV_ASSIGN expr
   44     | expr OP_MOD_ASSIGN expr
   45     | expr '+' expr
   46     | expr '-' expr
   47     | expr '*' expr
   48     | expr '/' expr
   49     | expr '%' expr
   50     | expr OP_EQ expr
   51     | expr OP_NEQ expr
   52     | expr '<' expr
   53     | expr OP_LE expr
   54     | expr '>' expr
   55     | expr OP_GE expr
   56     | expr OP_AND expr
   57     | expr OP_OR expr
   58     | expr '&' expr
   59     | expr '|' expr
   60     | expr '^' expr
   61     | expr OP_SHL expr
   62     | expr OP_SHR expr
   63     | '-' expr
   64     | '!' expr
   65     | '~' expr
   66     | '*' expr
   67     | expr '[' expr ']'
   68     | IDENTIFIER '(' opt_arg_list ')'
   69     | primary_expr

   70 opt_arg_list: %empty
   71             | arg_list

   72 arg_list: expr
   73         | arg_list ',' expr

   74 primary_expr: IDENTIFIER
   75             | INT_LITERAL
   76             | CHAR_LITERAL
   77             | STRING_LITERAL
   78             | KW_TRUE
   79             | KW_FALSE
   80             | '(' expr ')'


